# =============================================================================
# LLM API Configuration (at least one is required)
# =============================================================================

# DashScope (Tongyi Qianwen) - used for both LLM and Embedding
DASHSCOPE_API_KEY=sk-your-dashscope-api-key

# Anthropic (Claude)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key
ANTHROPIC_BASE_URL=https://api.anthropic.com

# MiniMax
ANTHROPIC_AUTH_TOKEN=your-minimax-token
ANTHROPIC_BASE_URL=https://api.minimax.chat

# Kimi (Moonshot)
ANTHROPIC_API_KEY=sk-your-kimi-key
ANTHROPIC_BASE_URL=https://api.moonshot.cn

# Bailian (Alibaba)
ANTHROPIC_AUTH_TOKEN=your-bailian-token
ANTHROPIC_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# =============================================================================
# Data Source Configuration
# =============================================================================

# Tushare (required for A-share data)
TUSHARE_TOKEN=your-tushare-token
TUSHARE_BASE_URL=https://api.tushare.pro

# =============================================================================
# Knowledge Base Configuration (optional)
# =============================================================================

# ChromaDB persist directory (default: knowledge/vector_store/)
# CHROMA_PERSIST_DIR=knowledge/vector_store/

# Embedding model (default: text-embedding-v4 via DashScope)
# EMBEDDING_MODEL=text-embedding-v4

# =============================================================================
# Application Configuration (optional)
# =============================================================================

# Default persona (default: zettaranc)
# DEFAULT_PERSONA=zettaranc

# Conversation TTL in seconds (default: 1800 = 30 minutes)
# CONVERSATION_TTL=1800
